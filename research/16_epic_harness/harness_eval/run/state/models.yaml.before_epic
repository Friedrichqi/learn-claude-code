# Model servers for the s15 benchmark profile. One entry per model; serve/serve.py turns it into `vllm serve`.
# All on vLLM 0.31.0 (/data/fritz/venv), prefix caching on, CUDA graphs on (no EPIC hooks this round).
# s15 sends no sampling parameters, so each model's generation_config.json applies (vLLM default).
# `agent` holds the S15Agent kwargs (window_tokens sets s15's CONTEXT_LIMIT; max_tokens overrides s15's
# per-call output budget for thinking models; the harness default is 8000, escalated to 16000).

qwen3-32b:
  hf: Qwen/Qwen3-32B
  hf_home: /data/shared/huggingface
  tp: 1
  gpu_util: 0.92
  max_model_len: 32768
  args: [--enable-auto-tool-choice, --tool-call-parser, hermes, --reasoning-parser, qwen3,
         --default-chat-template-kwargs, '{"enable_thinking": false}',
         --chat-template, /data/fritz/harness_eval/vendor/s15/templates/qwen3_append_only.jinja,
         --enable-prefix-caching, --enable-prompt-tokens-details, --max-num-seqs, "8"]
  agent: {window_tokens: 32768, max_tokens_reserve: 8192}
  arch: "full attention, GQA (64 layers, 8 KV heads), RoPE"
  note: "legacy comparison; topic 16 setup (append-only template, non-thinking)"

qwen3.8-27b:
  hf: Qwen/Qwen3.8-27B-FP8
  hf_home: /data/fritz/hf
  tp: 1
  gpu_util: 0.92
  max_model_len: 131072
  args: [--enable-auto-tool-choice, --tool-call-parser, qwen3_coder, --reasoning-parser, qwen3,
         --language-model-only, --enable-prefix-caching, --enable-mamba-shared-prefix-checkpoint,
         --enable-prompt-tokens-details, --max-num-seqs, "16"]
  agent: {window_tokens: 131072, max_tokens_reserve: 32000, max_tokens: 32000, max_tokens_escalated: 64000}
  arch: "hybrid: 48 Gated DeltaNet + 16 gated-attention layers (4 KV heads, partial RoPE)"
  note: "thinking on (vendor default effort)"

deepseek-v4-flash:
  hf: deepseek-ai/DeepSeek-V4-Flash-0731
  hf_home: /data/fritz/hf
  tp: 4
  gpu_util: 0.88
  max_model_len: 131072
  env: {SAFETENSORS_FAST_GPU: "1"}
  unset_env: [PYTORCH_CUDA_ALLOC_CONF]
  args: [--trust-remote-code, --kv-cache-dtype, fp8, --block-size, "256",
         --attention_config.indexer_kv_dtype, fp8,
         --tokenizer-mode, deepseek_v4, --tool-call-parser, deepseek_v4, --enable-auto-tool-choice,
         --reasoning-parser, deepseek_v4,
         --default-chat-template-kwargs, '{"thinking": true, "reasoning_effort": "high"}',
         --enable-prefix-caching, --enable-prompt-tokens-details, --max-num-seqs, "32"]
  agent: {window_tokens: 131072, max_tokens_reserve: 32000, max_tokens: 32000, max_tokens_escalated: 64000}
  arch: "compressed/sparse: CSA (4-token pooling, top-512) + HCA (128-token pooling) + 128-token window"
  note: "Think High; vendor recipes use 8 GPUs on H100 - serve test first, GLM-4.7-Flash is the backup"

minimax-m2.7:
  hf: MiniMaxAI/MiniMax-M2.7
  hf_home: /data/fritz/hf
  tp: 4
  gpu_util: 0.92
  max_model_len: 131072
  env: {SAFETENSORS_FAST_GPU: "1"}
  args: [--trust-remote-code, --enable-auto-tool-choice, --tool-call-parser, minimax_m2,
         --reasoning-parser, minimax_m2_append_think,
         --enable-prefix-caching, --enable-prompt-tokens-details, --max-num-seqs, "16"]
  agent: {window_tokens: 131072, max_tokens_reserve: 32000, max_tokens: 32000, max_tokens_escalated: 64000}
  arch: "full attention, GQA (62 layers, 8 KV heads), partial RoPE (64 of 128 dims)"
  note: "interleaved thinking kept in content (append_think parser)"

glm-4.7-flash:
  hf: zai-org/GLM-4.7-Flash
  hf_home: /data/fritz/hf
  tp: 1
  gpu_util: 0.92
  max_model_len: 131072
  args: [--enable-auto-tool-choice, --tool-call-parser, glm47, --reasoning-parser, glm47,
         --enable-prefix-caching, --enable-prompt-tokens-details, --max-num-seqs, "16"]
  agent: {window_tokens: 131072, max_tokens_reserve: 32000, max_tokens: 32000, max_tokens_escalated: 64000}
  arch: "MLA: 512-dim latent + 64-dim RoPE key (47 layers)"
  note: "backup for DeepSeek-V4-Flash"

# test-only: run/fake_model.py (scripted /v1/messages, no GPU) for batch.py checks; never served by vLLM
fake:
  hf: none
  tp: 1
  max_model_len: 32768
  agent: {window_tokens: 32768, max_tokens_reserve: 8192}
fake-b:
  hf: none
  tp: 1
  max_model_len: 32768
  agent: {window_tokens: 32768, max_tokens_reserve: 8192}
