-# The unreserved URI characters (RFC 3986)
-UNRESERVED_SET: Final = frozenset(
-    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz" + "0123456789-._~"
