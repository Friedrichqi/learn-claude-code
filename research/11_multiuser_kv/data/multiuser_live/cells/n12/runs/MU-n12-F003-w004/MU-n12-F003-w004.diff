-    elif isinstance(parameter_info, ArgumentInfo):
-        param_decls = [param.name]
-        nargs = None
-        if is_list:
-            nargs = -1
-        return (
-            TyperArgument(
-                # Argument
-                param_decls=param_decls,
-                type=parameter_type,
