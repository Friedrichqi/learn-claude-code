+
+        self.tqdm = tqdm(total=len(dsk), **self.kwargs)
+
+    def _finish(self, dsk, result, **kwargs):
+        """Finish the progress bar."""
+        self.tqdm.close()
+
+    def _posttask(self, key, value, dsk, state, worker_id):
+        """Update the progress bar after a task is completed."""
+        self.tqdm.update(1)
