+        """Update the progress bar after computation."""
+        self.tqdm.update(1)
+
+    def __enter__(self):
+        """Enter the context manager."""
+        return self
+
+    def __exit__(self, exc_type, exc_val, exc_tb):
+        """Exit the context manager."""
+        self.tqdm.close()
+
+    def __call__(self, func):
+        """Decorate a function."""
+        @wraps(func)
