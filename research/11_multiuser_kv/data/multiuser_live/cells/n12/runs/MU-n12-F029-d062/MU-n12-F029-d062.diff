+from typing import Any, Dict, List, Optional, Type, cast
+
+from annotated_doc import Doc
+from typer._types import TyperChoice
+from typer.core import TyperArgument, TyperOption
+from typer.models import ArgumentInfo, OptionInfo
+
+
+class CompletionItem:
+    """Represents an item in a completion list."""
+    
+    def __init__(self, value: str, help: Optional[str] = None) -> None:
+        self.value = value
+        self.help = help
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, CompletionItem):
+            return False
+        return self.value == other.value and self.help == other.help
+
+
+class CompletionContext:
+    """Context for completion."""
+    
+    def __init__(self, ctx: Any, incomplete: str) -> None:
+        self.ctx = ctx
+        self.incomplete = incomplete
+
+
+def get_completion_inspect_parameters(ctx: Any) -> Dict[str, Any]:
+    """Get parameters for completion inspection."""
+    
+    params = {}  # type: Dict[str, Any]
+    for param in ctx.command.get_params(ctx):
+        if isinstance(param, TyperOption):
+            for opt in param.opts:
+                params[opt] = param
+        elif isinstance(param, TyperArgument):
+            params[param.human_readable_name] = param
+    return params
