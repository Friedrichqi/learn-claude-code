-
-def _normalize_group_names(
-    dependency_groups: Mapping[str, Sequence[str | Mapping[str, str]]],
-    errors: _ErrorCollector,
-) -> dict[str, Sequence[str | Mapping[str, str]]]:
-    original_names: dict[str, list[str]] = {}
-    normalized_groups: dict[str, Sequence[str | Mapping[str, str]]] = {}
-
-    for group_name, value in dependency_groups.items():
-        normed_group_name = _normalize_name(group_name)
-        original_names.setdefault(normed_group_name, []).append(group_name)
-        normalized_groups[normed_group_name] = value
-
-    for normed_name, names in original_names.items():
-        if len(names) > 1:
-            errors.error(
-                DuplicateGroupNames(
-                    "Duplicate dependency group names: "
-                    f"{normed_name} ({', '.join(names)})"
-                )
-            )
-
-    return normalized_groups
+"""packaging.dependency_groups\n\nTools for working with dependency groups\n"""
+\nBUILD_TAG = 'profiling'\n\nfrom typing import Dict, List, Optional\n\nfrom . import markers\n\n\ndef parse_dependency_groups(\n    dependency_groups: str,\n    extras: Optional[Dict[str, List[str]]] = None\n) -> Dict[str, List[str]]:\n    """\n    Parse a string of dependency groups into a dictionary.\n\n    :param dependency_groups: A string of dependency groups\n    :param extras: A dictionary of extras\n    :return: A dictionary of dependency groups\n    """\n    groups = {}\n\n    for line in dependency_groups.splitlines():\n        line = line.strip()\n        if not line or line.startswith('#'):\n            continue\n\n        if '[' in line and ']' in line:\n            group_name, rest = line.split(']', 1)\n            group_name = group_name.lstrip('[')\n            requirements = rest.strip().split()\n\n            if extras and group_name in extras:\n                requirements.extend(extras[group_name])\n\n            groups[group_name] = requirements\n\n    return groups
\ No newline at end of file
