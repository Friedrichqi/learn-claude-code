-            raise ParserSyntaxError(
-                "Invalid quoted string",
-                source=tokenizer.source,
-                span=(token.position, token.position + len(token.text)),
-            ) from exc
-    else:
-        tokenizer.raise_syntax_error(
-            message="Expected a marker variable or quoted string"
-        )
