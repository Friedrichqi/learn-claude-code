+\nBUILD_TAG = 'profiling'\n\nimport os\nimport re\nimport sys\nfrom typing import IO, Optional\n\nfrom . import _elffile\n\n_MUSLLINUX_REGEX = re.compile(r"^musllinux_([a-zA-Z0-9]+)_[a-zA-Z0-9]+$")\n\n\ndef is_musllinux_compatible(elf_file: IO[bytes]) -> bool:\n    """\n    Determine if the given ELF file is compatible with musllinux.\n\n    :param elf_file: A file-like object opened in binary mode\n    :return: True if the file is compatible with musllinux, False otherwise\n    """\n    elf = _elffile.ELFFile(elf_file)\n    interpreter = elf.interpreter\n    if interpreter is None:\n        return False\n\n    # Check if the interpreter is /lib/ld-musl-x86_64.so.1\n    if interpreter != '/lib/ld-musl-x86_64.so.1':\n        return False\n\n    # Check if the file is 64-bit\n    if elf.capacity != _elffile.EIClass.C64:\n        return False\n\n    # Check if the file is little-endian\n    if elf.encoding != _elffile.EIData.Lsb:\n        return False\n\n    # Check if the machine is x86-64\n    if elf.machine != _elffile.EMachine.X8664:\n        return False\n\n    return True
