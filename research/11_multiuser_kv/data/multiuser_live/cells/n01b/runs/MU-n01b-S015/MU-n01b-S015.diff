+BUILD_TAG = 'profiling'
+"""Reconstruct task dependency graph from a JSONL trace file."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from collections import defaultdict
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Iterable, Iterator
+
+
+def load_trace(path: Path) -> list[dict[str, Any]]:
+    records = []
+    with path.open("r", encoding="utf-8") as handle:
+        for line_number, line in enumerate(handle, start=1):
+            if not line.strip():
+                continue
+            try:
+                record = json.loads(line)
+            except json.JSONDecodeError as exc:
+                raise ValueError(f"invalid JSON at {path}:{line_number}: {exc}") from exc
+            if not isinstance(record, dict) or not isinstance(record.get("event"), str):
+                raise ValueError(f"invalid trace record at {path}:{line_number}")
+            records.append(record)
+    records.sort(key=lambda event: int(event.get("monotonic_ns", 0)))
+    if not records:
+        raise ValueError(f"trace is empty: {path}")
+    return records
+
+
+def _latest_trace(directory: Path) -> Path:
+    candidates = sorted(directory.glob("run_*.jsonl"), key=lambda path: path.stat().st_mtime)
+    if not candidates:
+        raise ValueError(f"no run_*.jsonl files found in {directory}")
+    return candidates[-1]
+
+
+def _short(value: Any, limit: int = 100) -> str:
+    if isinstance(value, dict) and "preview" in value:
+        value = value.get("preview", "")
+    elif not isinstance(value, str):
+        value = json.dumps(value, ensure_ascii=True, sort_keys=True, default=str)
+    value = " ".join(str(value).split())
+    return value if len(value) <= limit else value[: max(0, limit - 3)] + "..."
+
+
+class Node:
+    def __init__(self, id: str, label: str, agent_id: str, task: str, kind: str, start_ns: int, end_ns: int):
+        self.id = id
+        self.label = label
+        self.agent_id = agent_id
+        self.task = task
+        self.kind = kind
+        self.start_ns = start_ns
+        self.end_ns = end_ns
+        self.dependencies: list[Node] = []
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "id": self.id,
+            "label": self.label,
+            "agent_id": self.agent_id,
+            "task": self.task,
+            "kind": self.kind,
+            "start": self.start_ns,
+            "end": self.end_ns,
+            "dependencies": [dep.id for dep in self.dependencies],
+        }
+
+
+def _is_tool_node(event: dict[str, Any]) -> bool:
+    return event.get("event") in {"tool_start", "tool_end"}
+
+
+def _is_model_node(event: dict[str, Any]) -> bool:
+    return event.get("event") in {"model_request", "model_response"}
+
+
+def _is_agent_node(event: dict[str, Any]) -> bool:
+    return event.get("event") in {"agent_start", "agent_end"}
+
+
+def _is_workflow_node(event: dict[str, Any]) -> bool:
+    return event.get("event") in {"workflow_node_start", "workflow_node_end"}
+
+
+def _is_harness_node(event: dict[str, Any]) -> bool:
+    return event.get("event") in {"harness_decision", "context_compact"}
+
+
+def _is_background_node(event: dict[str, Any]) -> bool:
+    return event.get("event") in {"background_start", "background_end"}
+
+
+def _is_message_node(event: dict[str, Any]) -> bool:
+    return event.get("event") in {"message_send"}
+
+
+def _is_dependency_node(event: dict[str, Any]) -> bool:
+    return event.get("event") in {"workflow_dependency"}
+
+
+def _is_unknown_node(event: dict[str, Any]) -> bool:
+    return not any(
+        _is_tool_node(event), _is_model_node(event), _is_agent_node(event),
+        _is_workflow_node(event), _is_harness_node(event), _is_background_node(event),
+        _is_message_node(event), _is_dependency_node(event)
+    )
+
+
+def _node_from_event(event: dict[str, Any]) -> Node | None:
+    event_type = event.get("event")
+    if event_type is None:
+        return None
+
+    agent_id = event.get("agent_id")
+    if agent_id is None:
+        agent_id = "harness"
+
+    data = event.get("data", {})
+    if not isinstance(data, dict):
+        data = {}
+
+    if _is_tool_node(event):
+        tool = data.get("tool", "unknown")
+        arguments = data.get("arguments", {})
+        status = data.get("status", "unknown")
+        return Node(
+            id=event.get("event_id", "unknown"),
+            label=f"Tool: {tool} {_short(arguments, 80)} -> {status}",
+            agent_id=agent_id,
+            task=data.get("task", "unknown"),
+            kind="tool",
+            start_ns=int(event.get("monotonic_ns", 0)),
+            end_ns=int(event.get("monotonic_ns", 0)),
+        )
+
+    if _is_model_node(event):
+        model = data.get("model", "unknown")
+        purpose = data.get("purpose", "unspecified")
+        return Node(
+            id=event.get("event_id", "unknown"),
+            label=f"LLM [{purpose}]",
+            agent_id=agent_id,
+            task=data.get("task", "unknown"),
+            kind="model",
+            start_ns=int(event.get("monotonic_ns", 0)),
+            end_ns=int(event.get("monotonic_ns", 0)),
+        )
+
+    if _is_agent_node(event):
+        role = data.get("role", "agent")
+        return Node(
+            id=event.get("event_id", "unknown"),
+            label=f"Agent: {role} ({agent_id})",
+            agent_id=agent_id,
+            task=data.get("task", "unknown"),
+            kind="agent",
+            start_ns=int(event.get("monotonic_ns", 0)),
+            end_ns=int(event.get("monotonic_ns", 0)),
+        )
+
+    if _is_workflow_node(event):
+        label = data.get("label", "unknown")
+        return Node(
+            id=event.get("event_id", "unknown"),
+            label=f"Workflow Node: {label}",
+            agent_id=agent_id,
+            task=data.get("task", "unknown"),
+            kind="workflow",
+            start_ns=int(event.get("monotonic_ns", 0)),
+            end_ns=int(event.get("monotonic_ns", 0)),
+        )
+
+    if _is_harness_node(event):
+        action = data.get("action", "unknown")
+        return Node(
+            id=event.get("event_id", "unknown"),
+            label=f"Harness: {action}",
+            agent_id=agent_id,
+            task=data.get("task", "unknown"),
+            kind="harness",
+            start_ns=int(event.get("monotonic_ns", 0)),
+            end_ns=int(event.get("monotonic_ns", 0)),
+        )
+
+    if _is_background_node(event):
+        tool = data.get("tool", "unknown")
+        return Node(
+            id=event.get("event_id", "unknown"),
+            label=f"Background: {tool}",
+            agent_id=agent_id,
+            task=data.get("task", "unknown"),
+            kind="background",
+            start_ns=int(event.get("monotonic_ns", 0)),
+            end_ns=int(event.get("monotonic_ns", 0)),
+        )
+
+    if _is_message_node(event):
+        from_agent = data.get("from")
+        to_agent = data.get("to")
+        message_type = data.get("message_type", "unknown")
+        return Node(
+            id=event.get("event_id", "unknown"),
+            label=f"Message: {from_agent} -> {to_agent} ({message_type})",
+            agent_id=agent_id,
+            task=data.get("task", "unknown"),
+            kind="message",
+            start_ns=int(event.get("monotonic_ns", 0)),
+            end_ns=int(event.get("monotonic_ns", 0)),
+        )
+
+    if _is_dependency_node(event):
+        from_node = data.get("from_node_id", "unknown")
+        to_node = data.get("to_node_id", "unknown")
+        return Node(
+            id=event.get("event_id", "unknown"),
+            label=f"Depends: {from_node} -> {to_node}",
+            agent_id=agent_id,
+            task=data.get("task", "unknown"),
+            kind="dependency",
+            start_ns=int(event.get("monotonic_ns", 0)),
+            end_ns=int(event.get("monotonic_ns", 0)),
+        )
+
+    if _is_unknown_node(event):
+        return Node(
+            id=event.get("event_id", "unknown"),
+            label=f"Unknown: {event_type}",
+            agent_id=agent_id,
+            task=data.get("task", "unknown"),
+            kind="unknown",
+            start_ns=int(event.get("monotonic_ns", 0)),
+            end_ns=int(event.get("monotonic_ns", 0)),
+        )
+
+    return None
+
+
+def _build_graph(events: list[dict[str, Any]]) -> dict[str, Node]:
+    nodes: dict[str, Node] = {}
+    for event in events:
+        node = _node_from_event(event)
+        if node is None:
+            continue
+        nodes[node.id] = node
+    for event in events:
+        node = nodes.get(event.get("event_id"))
+        if node is None:
+            continue
+        if _is_dependency_node(event):
+            data = event.get("data", {})
+            if not isinstance(data, dict):
+                continue
+            from_node_id = data.get("from_node_id")
+            if from_node_id in nodes:
+                node.dependencies.append(nodes[from_node_id])
+    return nodes
+
+
+def _format_node(node: Node) -> str:
+    return f"{node.id} {node.label} (Agent: {node.agent_id}, Task: {node.task})"
+
+
+def _render_graph_v2(nodes: dict[str, Node]) -> str:
+    lines = ["Task Dependency Graph"]
+    for node in nodes.values():
+        lines.append(f"  {_format_node(node)}")
+        for dep in node.dependencies:
+            lines.append(f"    Depends on: {_format_node(dep)}")
+    return "\n".join(lines)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("trace", nargs="?", type=Path,
+                        help="trace JSONL (default: latest file in traces/)")
+    parser.add_argument("--format", choices=("text", "json"), default="text",
+                        help="output format (default: text)")
+    args = parser.parse_args(argv)
+    try:
+        path = args.trace or _latest_trace(Path("traces"))
+        events = load_trace(path)
+    except (OSError, ValueError) as exc:
+        parser.error(str(exc))
+
+    graph = _build_graph(events)
+    if args.format == "json":
+        print(json.dumps({node_id: node.to_dict() for node_id, node in graph.items()}, indent=2))
+    else:
+        print(_render_graph_v2(graph))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
