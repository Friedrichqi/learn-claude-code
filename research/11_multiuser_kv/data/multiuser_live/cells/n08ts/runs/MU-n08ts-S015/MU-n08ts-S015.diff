-def _task_depends_on(task_id: str, target_id: str) -> bool:
-    """Return whether task_id transitively depends on target_id."""
-    pending = [task_id]
-    visited = set()
-    while pending:
-        current = pending.pop()
-        if current == target_id:
-            return True
-        if current in visited:
-            continue
-        visited.add(current)
-        pending.extend(load_task(current).blockedBy)
-    return False
