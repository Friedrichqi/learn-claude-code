+def interpreter_version() -> str:
+    """Return the interpreter version."""
+    return f"{sys.version_info.major}{sys.version_info.minor}"
+
+def mac_platforms() -> list[str]:
+    """Return a list of macOS platforms."""
+    return ["macosx_10_9_universal2", "macosx_10_10_universal2"]
+
+def sys_tags() -> list[Tag]:
+    """Return a list of tags for the current system."""
+    tags = []
+    # Add CPython tags
+    tags.extend(cpython_tags(PythonVersion(sys.version.split(" ")[0])))
+    # Add generic tags
+    tags.extend(generic_tags(PythonVersion(sys.version.split(" ")[0])))
+    return tags
+
+def tag_to_string(tag: Tag) -> str:
+    """Convert a tag to a string."""
+    return str(tag)
+
+def tags_to_strings(tags: Sequence[Tag]) -> list[str]:
+    """Convert a list of tags to a list of strings."""
+    return [tag_to_string(tag) for tag in tags]
+
+def windows_platforms() -> list[str]:
+    """Return a list of Windows platforms."""
+    return ["win32", "win_amd64"]
