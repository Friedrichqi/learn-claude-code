+        name = event.get("event")
+        if not span_id:
+            continue
+        if name in START_TO_END:
+            starts[str(span_id)] = event
+            continue
+        start = starts.get(str(span_id))
+        if start is None or name not in START_TO_END.get(start.get("event"), set()):
