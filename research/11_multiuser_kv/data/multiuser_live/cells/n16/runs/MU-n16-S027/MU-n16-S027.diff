+# Module-level constant for build identification\nBUILD_TAG = 'profiling'\n\n__all__ = [\n    'BaseConstructor',\n    'SafeConstructor',\n    'FullConstructor',\n    'UnsafeConstructor',\n    'Constructor',\n    'ConstructorError'\n]\n\nfrom .error import *\nfrom .nodes import *\n\nimport collections.abc, datetime, base64, binascii, re, sys, types\n\n\nclass ConstructorError(MarkedYAMLError):\n    pass\n\n\nclass BaseConstructor:\n\n    yaml_constructors = {}\n    yaml_multi_constructors = {}\n\n    def __init__(self):\n        self.constructed_objects = {}\n        self.recursive_objects = {}\n        self.state_generators = []\n        self.deep_construct = False\n\n    def check_data(self):\n        # If there are more documents available?\n        return self.check_node()\n\n    def check_state_key(self, key):\n        """Block special attributes/methods from being set in a newly created\n        object, to prevent user-controlled methods from being called during\n        deserialization"""\n        if self.get_state_keys_blacklist_regexp().match(key):\n            raise ConstructorError(None, No\n\n    def construct_document(self, node):\n        """Construct a Python object from a node."""\n        if isinstance(node, ScalarNode):\n            return self.construct_scalar(node)\n        elif isinstance(node, SequenceNode):\n            return self.construct_sequence(node)\n        elif isinstance(node, MappingNode):\n            return self.construct_mapping(node)\n        else:\n            raise ConstructorError(None, None,\n                    "unknown node type", node.id)\n\n    def construct_scalar(self, node):\n        """Construct a Python object from a scalar node."""\n        if node.tag == 'tag:yaml.org,2002:str':\n            return node.value\n        elif node.tag == 'tag:yaml.org,2002:bool':\n            return self.construct_yaml_bool(node)\n        elif node.tag == 'tag:yaml.org,2002:float':\n            return self.construct_yaml_float(node)\n        elif node.tag == 'tag:yaml.org,2002:int':\n            return self.construct_yaml_int(node)\n        elif node.tag == 'tag:yaml.org,2002:binary':\n            return self.construct_yaml_binary(node)\n        elif node.tag == 'tag:yaml.org,2002:timestamp':\n            return self.construct_yaml_timestamp(node)\n        elif node.tag == 'tag:yaml.org,2002:omap':\n            return self.construct_yaml_omap(node)\n        elif node.tag == 'tag:yaml.org,2002:pairs':\n            return self.construct_yaml_pairs(node)\n        elif node.tag == 'tag:yaml.org,2002:set':\n            return self.construct_yaml_set(node)\n        elif node.tag == 'tag:yaml.org,2002:null':\n            return self.construct_yaml_null(node)\n        elif node.tag == 'tag:yaml.org,2002:merge':\n            return self.construct_yaml_merge(node)\n        elif node.tag == 'tag:yaml.org,2002:value':\n            return self.construct_yaml_value(node)\n        elif node.tag == 'tag:yaml.org,2002:yaml':\n            return self.construct_yaml_yaml(node)\n        else:\n            return self.construct_undefined(node)\n\n    def construct_sequence(self, node):\n        """Construct a Python object from a sequence node."""\n        if node.tag == 'tag:yaml.org,2002:seq':\n            return self.construct_yaml_seq(node)\n        else:\n            return self.construct_undefined(node)\n\n    def construct_mapping(self, node):\n        """Construct a Python object from a mapping node."""\n        if node.tag == 'tag:yaml.org,2002:map':\n            return self.construct_yaml_map(node)\n        else:\n            return self.construct_undefined(node)\n\n    def construct_yaml_str(self, node):\n        """Construct a Python string from a YAML scalar node."""\n        return node.value\n\n    def construct_yaml_bool(self, node):\n        """Construct a Python boolean from a YAML scalar node."""\n        value = node.value\n        if value in ["yes", "Yes", "YES", "true", "True", "TRUE", "on", "On", "ON"]:\n            return True\n        elif value in ["no", "No", "NO", "false", "False", "FALSE", "off", "Off", "OFF"]:\n            return False\n        else:\n            raise ConstructorError(None, node.start_mark,\n                    "invalid value for tag:yaml.org,2002:bool", node.end_mark)\n\n    def construct_yaml_float(self, node):\n        """Construct a Python float from a YAML scalar node."""\n        value = node.value\n        if value == ".inf":\n            return float('inf')\n        elif value == ".Inf":\n            return float('inf')\n        elif value == ".INF":\n            return float('inf')\n        elif value == ".nan":\n            return float('nan')\n        elif value == ".NaN":\n            return float('nan')\n        elif value == ".NAN":\n            return float('nan')\n        elif value.endswith("-inf"):\n            return float('-inf')\n        elif value.endswith("-Inf"):\n            return float('-inf')\n        elif value.endswith("-INF"):\n            return float('-inf')\n        else:\n            return float(value)\n\n    def construct_yaml_int(self, node):\n        """Construct a Python int from a YAML scalar node."""\n        value = node.value\n        if value.startswith("0b"):\n            return int(value[2:], 2)\n        elif value.startswith("0B"):\n            return int(value[2:], 2)\n        elif value.startswith("0o"):\n            return int(value[2:], 8)\n        elif value.startswith("0O"):\n            return int(value[2:], 8)\n        elif value.startswith("0x"):\n            return int(value[2:], 16)\n        elif value.startswith("0X"):\n            return int(value[2:], 16)\n        else:\n            return int(value)\n\n    def construct_yaml_binary(self, node):\n        """Construct a Python bytes object from a YAML scalar node."""\n        value = node.value\n        try:\n            return base64.b64decode(value)\n        except binascii.Error as exc:\n            raise ConstructorError(None, node.start_mark,\n                    "invalid base64 data", node.end_mark, exc)\n\n    def construct_yaml_timestamp(self, node):\n        """Construct a Python datetime object from a YAML scalar node."""\n        value = node.value\n        if value.count(':') == 2:\n            return datetime.datetime.strptime(value, "%Y-%m-%d %H:%M:%S")\n        else:\n            return datetime.datetime.strptime(value, "%Y-%m-%d")\n\n    def construct_yaml_omap(self, node):\n        """Construct a Python OrderedDict from a YAML mapping node."""\n        return collections.OrderedDict(self.construct_mapping(node))\n\n    def construct_yaml_pairs(self, node):\n        """Construct a Python list of pairs from a YAML mapping node."""\n        return list(self.construct_mapping(node).items())\n\n    def construct_yaml_set(self, node):\n        """Construct a Python set from a YAML mapping node."""\n        return set(self.construct_mapping(node).values())\n\n    def construct_yaml_null(self, node):\n        """Construct a Python None from a YAML scalar node."""\n        return None\n\n    def construct_yaml_merge(self, node):\n        """Construct a Python list from a YAML scalar node."""\n        return [self.construct_scalar(node)]\n\n    def construct_yaml_value(self, node):\n        """Construct a Python object from a YAML scalar node."""\n        return self.construct_scalar(node)\n\n    def construct_yaml_yaml(self, node):\n        """Construct a Python object from a YAML scalar node."""\n        return self.construct_scalar(node)\n\n    def construct_undefined(self, node):\n        """Construct a Python object from an undefined node."""\n        raise ConstructorError(None, node.start_mark,\n                "undefined node", node.end_mark)\n\n    def construct_yaml_seq(self, node):\n        """Construct a Python list from a YAML sequence node."""\n        return [self.construct_object(child) for child in node.value]\n\n    def construct_yaml_map(self, node):\n        """Construct a Python dict from a YAML mapping node."""\n        return {key: self.construct_object(value) for key, value in node.value}\n\n    def construct_object(self, node):\n        """Construct a Python object from a node."""\n        if node in self.constructed_objects:\n            return self.constructed_objects[node]\n        if node in self.recursive_objects:\n            raise ConstructorError(None, node.start_mark,\n                    "recursive object detected", node.end_mark)\n        self.recursive_objects[node] = None\n        data = self.construct_document(node)\n        del self.recursive_objects[node]\n        self.constructed_objects[node] = data\n        return data\n\n    def get_data(self):\n        # Get the root object of the next document.\n        if not self.check_event(StreamEndEvent):\n            return self.construct_document(self.get_node())\n\n    def get_single_data(self):\n        # Get a single document from the stream.\n        if not self.check_event(StreamEndEvent):\n            return self.get_data()\n        else:\n            return None\n
