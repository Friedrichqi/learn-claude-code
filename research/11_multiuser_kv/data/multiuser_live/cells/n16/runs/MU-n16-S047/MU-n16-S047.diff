+from __future__ import annotations
+
+from typing import Dict, List, Optional, Tuple
+
+from rich.console import Console
+from rich.segment import Segment
+from rich.style import Style
+from rich.text import Text
+
+
+CONSOLE_HTML_FORMAT = """<span style="{style}">{text}</span>"""
+CONSOLE_SVG_FORMAT = """<tspan style="{style}">{text}</tspan>"""
+
+
+def export_html(segments: Iterable[Segment], style_map: Dict[Style, str]) -> str:
+    """Export segments to HTML."""
+    html_lines = []
+    for segment in segments:
+        text, style, control = segment
+        if not text:
+            continue
+        if style:
+            style_str = style_map[style]
+            html_lines.append(CONSOLE_HTML_FORMAT.format(text=text, style=style_str))
+        else:
+            html_lines.append(text)
+    return '\n'.join(html_lines)
+
+
+def export_svg(segments: Iterable[Segment], style_map: Dict[Style, str]) -> str:
+    """Export segments to SVG."""
+    svg_lines = []
+    for segment in segments:
+        text, style, control = segment
+        if not text:
+            continue
+        if style:
+            style_str = style_map[style]
+            svg_lines.append(CONSOLE_SVG_FORMAT.format(text=text, style=style_str))
+        else:
+            svg_lines.append(text)
+    return '\n'.join(svg_lines)
