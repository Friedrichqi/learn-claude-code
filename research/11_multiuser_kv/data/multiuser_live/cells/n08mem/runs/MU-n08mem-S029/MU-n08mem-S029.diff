-        if not isinstance(cmd, Command):
-            raise TypeError("Callback is not a command.")
-
-        for param in self.params:
-            if param not in kwargs:
-                kwargs[param] = self.params[param]
-
-        return self.invoke(cmd, *args, **kwargs)
