+class Parser:
+    """A recursive descent parser for dependency specifiers."""
+
+    def __init__(self, input: str):
+        self.tokenizer = _tokenizer.Tokenizer(input)
+
+    def parse(self) -> Optional[str]:
+        """Parse the input into a dependency specifier."""
+        return self.parse_expression()
+
+    def parse_expression(self) -> Optional[str]:
+        """Parse an expression consisting of one or more terms separated by 'and' or 'or' operators."""
+        left = self.parse_term()
+        if left is None:
+            return None
+        while self.tokenizer.peek() in ('and', 'or'):
+            op = self.tokenizer.consume()
+            right = self.parse_term()
+            if right is None:
+                return None
+            left = f"{left} {op} {right}"
+        return left
+
+    def parse_term(self) -> Optional[str]:
+        """Parse a term consisting of one or more factors separated by commas."""
+        left = self.parse_factor()
+        if left is None:
+            return None
+        while self.tokenizer.peek() == ',':
+            self.tokenizer.consume()
+            right = self.parse_factor()
+            if right is None:
+                return None
+            left = f"{left}, {right}"
+        return left
+
+    def parse_factor(self) -> Optional[str]:
+        """Parse a factor consisting of a version specifier or a marker."""
+        token = self.tokenizer.parse_token()
+        if token is None:
+            return None
+        if token in ('==', '!=', '>=', '<=', '>', '<'):
+            # Version specifier
+            version = self.tokenizer.parse_token()
+            if version is None:
+                return None
+            return f"{token} {version}"
+        elif token == 'extra' and self.tokenizer.peek() == '==':
+            # Marker
+            self.tokenizer.consume()
+            value = self.tokenizer.parse_token()
+            if value is None:
+                return None
+            return f"{token} == {value}"
+        else:
+            # Unknown token
+            return token
