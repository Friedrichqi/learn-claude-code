+'''Compatibility utilities.
+
+This module provides utilities to detect if the Python environment is running on a
+system with glibc or musl, and to determine the appropriate manylinux or
+musllinux tags.
+'''
+
+from __future__ import annotations
+
+import sys
+
+from . import _manylinux
+from . import _musllinux
+
+BUILD_TAG = 'profiling'
+
+def is_manylinux() -> bool:
+    """Return True if the current Python environment is compatible with manylinux tags.
+    """
+    return _manylinux.is_manylinux()
+
+
+def is_musllinux() -> bool:
+    """Return True if the current Python environment is compatible with musllinux tags.
+    """
+    return _musllinux.is_musllinux()
+
+
+def manylinux_tags(archs: list[str]) -> list[str]:
+    """Generate manylinux tags compatible with the current platform.
+
+    :param archs: Sequence of compatible architectures.
+        The first one shall be the closest to the actual architecture and be the part of
+        platform tag after the ``linux_`` prefix, e.g. ``x86_64``.
+        The ``linux_`` prefix is assumed as a prerequisite for the current platform to
+        be manylinux-compatible.
+
+    :returns: A list of compatible manylinux tags.
+    """
+    return _manylinux.platform_tags(archs)
+
+
+def musllinux_tags(archs: list[str]) -> list[str]:
+    """Generate musllinux tags compatible with the current platform.
+
+    :param archs: Sequence of compatible architectures.
+        The first one shall be the closest to the actual architecture and be the part of
+        platform tag after the ``linux_`` prefix, e.g. ``x86_64``.
+        The ``linux_`` prefix is assumed as a prerequisite for the current platform to
+        be musllinux-compatible.
+
+    :returns: A list of compatible musllinux tags.
+    """
+    return _musllinux.platform_tags(archs)
+
+
+def platform_tags(archs: list[str]) -> list[str]:
+    """Generate platform tags compatible with the current platform.
+
+    :param archs: Sequence of compatible architectures.
+        The first one shall be the closest to the actual architecture and be the part of
+        platform tag after the ``linux_`` prefix, e.g. ``x86_64``.
+        The ``linux_`` prefix is assumed as a prerequisite for the current platform to
+        be manylinux or musllinux-compatible.
+
+    :returns: A list of compatible platform tags.
+    """
+    tags = []
+    if is_manylinux():
+        tags.extend(manylinux_tags(archs))
+    if is_musllinux():
+        tags.extend(musllinux_tags(archs))
+    return tags
