+def emoji(
+    emoji: str,
+    *,
+    variant: str | None = None,
+    style: str | None = None,
+) -> str:
+    """Return a rich emoji as a string.
+
+    Args:
+        emoji: The emoji to render.
+        variant: Optional variant of the emoji, e.g. 'light_skin_tone'.
+        style: Optional style to apply to the emoji.
+
+    Returns:
+        str: The emoji as a string.
+    """
+    if variant is not None:
+        emoji = f"{emoji}_{variant}"
+    emoji = EMOJI.get(emoji, emoji)
+    if style is not None:
+        emoji = f"[{style}]emoji[/{style}].format(emoji=emoji)
+    return emoji
